          <mxGeometry x="810" y="305" width="160" height="45" as="geometry" />
        </mxCell>
        <mxCell id="sync6" value="🔄 Seek 同步&#xa;whisper_seek_req/pos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="810" y="360" width="160" height="45" as="geometry" />
        </mxCell>
        <mxCell id="sync7" value="⏸️ 预缓冲机制&#xa;暂停 → 首条字幕 → 恢复" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;fontSize=10;" vertex="1" parent="1">
