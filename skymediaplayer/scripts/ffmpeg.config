# ===================================================================
# FFmpeg Configure 参数配置
#
# 格式说明：
#   - 每行一个参数，支持 # 注释
#   - 空行和注释行自动忽略
#   - 编译脚本会自动注入交叉编译相关参数（CC/CXX/sysroot/prefix 等）
#   - 修改后执行: ./build_deps.sh --component=ffmpeg --install
# ===================================================================

# ----- 库类型（FFmpeg 子库静态合并为 libskyffmpeg.so）-----
--disable-shared
--enable-static

# ----- 基础配置 -----
--disable-programs
--disable-doc
--disable-symver
--enable-pic
--disable-asm
--disable-vulkan

# ----- 网络支持 -----
--enable-network
--enable-openssl

# ----- AI 字幕 -----
--enable-whisper

# ----- 硬件加速 -----
--enable-jni
--enable-mediacodec

# ----- 精简构建：先禁用所有，再按需启用 -----
--disable-everything

# ----- 解码器 -----
--enable-decoder=hevc
--enable-decoder=h264
--enable-decoder=aac
--enable-decoder=mpeg4
--enable-decoder=mpeg2video
--enable-decoder=vp8
--enable-decoder=vp9

# ----- 解封装器 -----
--enable-demuxer=mov
--enable-demuxer=mp4
--enable-demuxer=avi
--enable-demuxer=matroska
--enable-demuxer=webm
--enable-demuxer=hls
--enable-demuxer=mpegts

# ----- 解析器 -----
--enable-parser=h264
--enable-parser=hevc
--enable-parser=aac
--enable-parser=mpeg4video
--enable-parser=vp8
--enable-parser=vp9

# ----- 协议 -----
--enable-protocol=file
--enable-protocol=http
--enable-protocol=https
--enable-protocol=tcp
--enable-protocol=udp
--enable-protocol=rtp
--enable-protocol=rtsp
--enable-protocol=hls

# ----- 滤镜 -----
--enable-filter=whisper
--enable-filter=aresample
--enable-filter=abuffer
--enable-filter=abuffersink
