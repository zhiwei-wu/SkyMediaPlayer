        <mxCell id="legend-new" value="🆕 新增" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="760" width="70" height="25" as="geometry" />
        </mxCell>
        <mxCell id="legend-config" value="⚙️ 配置" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="150" y="760" width="70" height="25" as="geometry" />
        </mxCell>
        <mxCell id="legend-abstract" value="🔷 抽象" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="230" y="760" width="70" height="25" as="geometry" />
        </mxCell>
        <mxCell id="legend-impl" value="📄 实现" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="310" y="760" width="70" height="25" as="geometry" />
        </mxCell>
        <mxCell id="legend-ext" value="📦 外部库" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4edda;strokeColor=#28a745;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="390" y="760" width="80" height="25" as="geometry" />
        </mxCell>
        <mxCell id="legend-info" value="本次新增: Vulkan 渲染后端 (SkyVkRenderer) + MediaCodec 硬件解码 (SkyMediaCodecDecoder) + 三级回退策略 + 用户偏好配置" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="480" y="760" width="650" height="25" as="geometry" />
