          <mxGeometry x="740" y="230" width="160" height="70" as="geometry"/>
        </mxCell>

        <!-- 根因发现 -->
        <mxCell id="h_root" value="🔍 根因定位&#xa;HW_SURFACE: pictq 为空&#xa;HW_BUFFER: pts 全是 NaN&#xa;→ MediaCodec 与 HLS 不兼容" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="230" width="200" height="80" as="geometry"/>
