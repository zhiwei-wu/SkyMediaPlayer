  </diagram>
  <diagram id="subtitle-sync" name="Subtitle Sync">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ==================== Title ==================== -->
        <mxCell id="ss-title" value="字幕同步：时间窗口算法" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#1a237e;" vertex="1" parent="1">
          <mxGeometry x="300" y="10" width="400" height="30" as="geometry" />
        </mxCell>

        <!-- ==================== Input: Subtitle Arrives ==================== -->
        <mxCell id="ss-input" value="收到字幕&#xa;(text, startTimeMs, endTimeMs)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="55" width="250" height="45" as="geometry" />
        </mxCell>

        <!-- ==================== Compute Window ==================== -->
        <mxCell id="ss-compute" value="计算时间窗口参数&#xa;windowStart = startTime - interval/2&#xa;windowEnd = startTime + interval/2&#xa;discardLine = startTime + interval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="330" y="120" width="270" height="65" as="geometry" />
        </mxCell>
        <mxCell id="ss-arr1" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="465" y="100" as="sourcePoint" />
            <mxPoint x="465" y="120" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ==================== Decision Diamond ==================== -->
        <mxCell id="ss-decision" value="判断字幕&#xa;展示时机" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f9a825;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="210" width="130" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ss-arr2" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="465" y="185" as="sourcePoint" />
            <mxPoint x="465" y="210" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ==================== Case 1: Discard (Left) ==================== -->
        <mxCell id="ss-discard" value="🗑️ 丢弃&#xa;字幕太旧" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcdd2;strokeColor=#c62828;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="235" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ss-discard-cond" value="discardLine &lt; currentPos" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontColor=#c62828;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="180" y="215" width="160" height="20" as="geometry" />
        </mxCell>
        <mxCell id="ss-arr-discard" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#c62828;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="400" y="260" as="sourcePoint" />
            <mxPoint x="240" y="260" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ==================== Case 2: Display Now (Right) ==================== -->
        <mxCell id="ss-display" value="✅ 立即展示&#xa;正好在窗口内" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="690" y="235" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ss-display-cond" value="currentPos ∈ [windowStart, windowEnd]" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontColor=#2e7d32;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="560" y="215" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="ss-arr-display" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#2e7d32;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="530" y="260" as="sourcePoint" />
            <mxPoint x="690" y="260" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ==================== Case 3: Queue (Down) ==================== -->
        <mxCell id="ss-queue" value="⏳ 加入等待队列&#xa;字幕超前" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="395" y="350" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ss-queue-cond" value="startTime &gt; currentPos + interval/2" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontColor=#1565c0;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="470" y="320" width="180" height="20" as="geometry" />
        </mxCell>
        <mxCell id="ss-arr-queue" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#1565c0;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="465" y="310" as="sourcePoint" />
            <mxPoint x="465" y="350" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ==================== Pending Queue Detail ==================== -->
        <mxCell id="ss-pq-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="300" y="420" width="330" height="180" as="geometry" />
        </mxCell>
        <mxCell id="ss-pq-title" value="等待队列 (pendingSubtitleQueue)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fontColor=#1565c0;" vertex="1" parent="1">
          <mxGeometry x="330" y="425" width="270" height="20" as="geometry" />
        </mxCell>
        <mxCell id="ss-pq-desc" value="按 startTimeMs 排序存储" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#666;" vertex="1" parent="1">
