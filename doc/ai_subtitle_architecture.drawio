        <mxCell id="t3-step3" value="送入 Whisper 音频滤镜推理&#xa;(Vulkan GPU / CPU)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8bbd0;strokeColor=#c62828;fontSize=10;" vertex="1" parent="1">
