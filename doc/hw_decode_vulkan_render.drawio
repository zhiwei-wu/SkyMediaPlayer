  </diagram>
  <diagram name="硬件解码流程图" id="hw-decode-flow">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="flow-title" value="MediaCodec 硬件解码流程图" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="10" width="400" height="30" as="geometry" />
        </mxCell>

        <!-- Start -->
        <mxCell id="start" value="开始播放" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="50" width="120" height="40" as="geometry" />
        </mxCell>

        <!-- Check Decoder Mode -->
        <mxCell id="check-mode" value="用户设置的&#xa;DecoderMode?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="460" y="120" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="start-to-check" value="" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="start" target="check-mode">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- SOFTWARE path -->
        <mxCell id="sw-path" value="FFmpeg 软解" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="140" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="check-to-sw" value="SOFTWARE" style="endArrow=classic;html=1;strokeWidth=2;fontColor=#666666;fontSize=10;" edge="1" parent="1" source="check-mode" target="sw-path">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Try Surface Mode -->
        <mxCell id="try-surface" value="尝试 Surface 模式&#xa;AMediaCodec_configure(codec, format, window, ...)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="420" y="240" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="check-to-surface" value="AUTO / HW_SURFACE" style="endArrow=classic;html=1;strokeWidth=2;fontColor=#b85450;fontSize=10;" edge="1" parent="1" source="check-mode" target="try-surface">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Surface Success? -->
        <mxCell id="surface-ok" value="成功?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="490" y="320" width="100" height="60" as="geometry" />
        </mxCell>
        <mxCell id="surface-to-check" value="" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="try-surface" target="surface-ok">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Surface Mode Active -->
        <mxCell id="surface-active" value="✅ HW_SURFACE 模式&#xa;零拷贝直渲到 ANativeWindow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="325" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="surface-ok-yes" value="✅ 是" style="endArrow=classic;html=1;strokeWidth=2;fontColor=#82b366;fontSize=10;" edge="1" parent="1" source="surface-ok" target="surface-active">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Try Buffer Mode -->
        <mxCell id="try-buffer" value="尝试 Buffer 模式&#xa;AMediaCodec_configure(codec, format, null, ...)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="420" y="420" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="surface-fail" value="❌ 否" style="endArrow=classic;html=1;strokeWidth=2;fontColor=#b85450;fontSize=10;" edge="1" parent="1" source="surface-ok" target="try-buffer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Buffer Success? -->
        <mxCell id="buffer-ok" value="成功?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="490" y="500" width="100" height="60" as="geometry" />
        </mxCell>
        <mxCell id="buffer-to-check" value="" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="try-buffer" target="buffer-ok">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Buffer Mode Active -->
        <mxCell id="buffer-active" value="✅ HW_BUFFER 模式&#xa;输出 NV12 帧到渲染器" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="505" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="buffer-ok-yes" value="✅ 是" style="endArrow=classic;html=1;strokeWidth=2;fontColor=#82b366;fontSize=10;" edge="1" parent="1" source="buffer-ok" target="buffer-active">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Fallback to Software -->
        <mxCell id="fallback-sw" value="⚠️ 回退到 FFmpeg 软解&#xa;avcodec_send_packet / avcodec_receive_frame" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="420" y="600" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="buffer-fail" value="❌ 否" style="endArrow=classic;html=1;strokeWidth=2;fontColor=#b85450;fontSize=10;" edge="1" parent="1" source="buffer-ok" target="fallback-sw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Decode Loop Section -->
        <mxCell id="decode-section-title" value="解码循环 (video_thread_hw)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;fontColor=#1a5276;" vertex="1" parent="1">
          <mxGeometry x="50" y="700" width="300" height="25" as="geometry" />
        </mxCell>

        <mxCell id="send-packet" value="1. sendPacket(AVPacket)&#xa;AvcC→AnnexB 转换&#xa;AMediaCodec_queueInputBuffer()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="50" y="740" width="220" height="55" as="geometry" />
        </mxCell>
        <mxCell id="receive-frame" value="2. receiveFrame(AVFrame)&#xa;AMediaCodec_dequeueOutputBuffer()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="300" y="740" width="220" height="55" as="geometry" />
        </mxCell>
        <mxCell id="surface-render" value="3a. Surface模式&#xa;releaseOutputBuffer(true)&#xa;→ 直渲到屏幕" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="550" y="730" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="buffer-render" value="3b. Buffer模式&#xa;fillFrameFromBuffer()&#xa;→ OpenGL/Vulkan 渲染" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="550" y="790" width="170" height="50" as="geometry" />
        </mxCell>

        <mxCell id="send-to-receive" value="" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="send-packet" target="receive-frame">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="receive-to-surface" value="" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="receive-frame" target="surface-render">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="receive-to-buffer" value="" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="receive-frame" target="buffer-render">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- sw-path to decode loop -->
        <mxCell id="sw-to-end" value="avcodec_send_packet()&#xa;avcodec_receive_frame()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="50" y="600" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sw-path-to-end" value="" style="endArrow=classic;html=1;strokeWidth=2;dashed=1;" edge="1" parent="1" source="sw-path" target="sw-to-end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Vulkan渲染流程图" id="vulkan-render-flow">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="vk-flow-title" value="Vulkan 渲染一帧视频的完整流程" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="10" width="500" height="30" as="geometry" />
        </mxCell>

        <!-- Step 1: displayImage called -->
        <mxCell id="step1" value="displayImage(window, frame)&#xa;渲染入口" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="50" width="220" height="50" as="geometry" />
        </mxCell>

        <!-- Step 2: Check init -->
        <mxCell id="step2" value="已初始化?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="490" y="130" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s1-s2" value="" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="step1" target="step2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Init Pipeline -->
        <mxCell id="init-pipeline" value="完整初始化&#xa;Instance → PhysicalDevice → Device&#xa;→ Swapchain → RenderPass → Pipeline&#xa;→ Framebuffers → CommandBuffers → SyncObjects" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="150" y="120" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s2-init" value="否" style="endArrow=classic;html=1;strokeWidth=2;fontColor=#b85450;fontSize=10;" edge="1" parent="1" source="step2" target="init-pipeline">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Step 3: Check format -->
        <mxCell id="step3" value="像素格式变化?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="475" y="230" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s2-s3" value="是" style="endArrow=classic;html=1;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="step2" target="step3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="init-to-s3" value="" style="endArrow=classic;html=1;strokeWidth=2;dashed=1;" edge="1" parent="1" source="init-pipeline" target="step3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Rebuild textures -->
        <mxCell id="rebuild-tex" value="重建纹理资源&#xa;+ 选择对应 Shader" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="200" y="235" width="180" height="45" as="geometry" />
        </mxCell>
        <mxCell id="s3-rebuild" value="是" style="endArrow=classic;html=1;strokeWidth=2;fontColor=#9673a6;fontSize=10;" edge="1" parent="1" source="step3" target="rebuild-tex">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Step 4: Upload texture -->
        <mxCell id="step4" value="上传纹理数据&#xa;映射 Staging Buffer → 复制帧数据&#xa;→ 转换 Layout → Buffer→Image 拷贝" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="420" y="330" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s3-s4" value="否" style="endArrow=classic;html=1;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="step3" target="step4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rebuild-to-s4" value="" style="endArrow=classic;html=1;strokeWidth=2;dashed=1;" edge="1" parent="1" source="rebuild-tex" target="step4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Step 5: Wait fence -->
        <mxCell id="step5" value="vkWaitForFences()&#xa;等待前一帧完成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="460" y="420" width="180" height="45" as="geometry" />
        </mxCell>
        <mxCell id="s4-s5" value="" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="step4" target="step5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Step 6: Acquire image -->
        <mxCell id="step6" value="vkAcquireNextImageKHR()&#xa;获取 Swapchain 图像" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="460" y="490" width="180" height="45" as="geometry" />
        </mxCell>
        <mxCell id="s5-s6" value="" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="step5" target="step6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Step 7: Record commands -->
        <mxCell id="step7" value="录制命令缓冲&#xa;BeginRenderPass → BindPipeline&#xa;→ BindDescriptorSets → Draw(4 vertices)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="420" y="565" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s6-s7" value="" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="step6" target="step7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Step 8: Submit -->
        <mxCell id="step8" value="vkQueueSubmit()&#xa;提交渲染命令" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="460" y="655" width="180" height="45" as="geometry" />
        </mxCell>
        <mxCell id="s7-s8" value="" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="step7" target="step8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Step 9: Present -->
        <mxCell id="step9" value="vkQueuePresentKHR()&#xa;展示到屏幕" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="730" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s8-s9" value="" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="step8" target="step9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Sync annotations -->
        <mxCell id="sync-box" value="同步机制&#xa;&#xa;• imageAvailableSemaphore: 图像获取完成&#xa;• renderFinishedSemaphore: 渲染完成&#xa;• inFlightFence: CPU 等待 GPU&#xa;• MAX_FRAMES_IN_FLIGHT = 2 (双缓冲)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="750" y="450" width="300" height="110" as="geometry" />
        </mxCell>

        <!-- Shader annotation -->
        <mxCell id="shader-box" value="SPIR-V Shader (预编译)&#xa;&#xa;• YUV420P: 3纹理 (Y+U+V) → RGB&#xa;• NV12: 2纹理 (Y+UV) → RGB&#xa;• NV21: 2纹理 (Y+VU) → RGB&#xa;• RGBA: 1纹理 直接输出" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="750" y="580" width="300" height="100" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="硬解直渲音画同步流程" id="hw-surface-sync">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="sync-title" value="Surface 直渲模式音画同步流程" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="10" width="500" height="30" as="geometry" />
        </mxCell>

        <!-- Problem Description -->
        <mxCell id="problem-box" value="修复前的问题：receiveFrame 内部直接调用 releaseOutputBuffer(true) 渲染到 Surface&#xa;没有任何同步控制，导致画面比声音快很多" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="50" y="50" width="700" height="50" as="geometry" />
        </mxCell>

        <!-- Start Node -->
        <mxCell id="start" value="video_thread_hw 循环" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="130" width="160" height="50" as="geometry" />
        </mxCell>

        <!-- Pause Check -->
        <mxCell id="pause-check" value="is->paused?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="70" y="210" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="start-to-pause" value="" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="start" target="pause-check">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Pause Sleep -->
        <mxCell id="pause-sleep" value="暂停中&#xa;av_usleep(10000)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="70" y="300" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="pause-yes" value="是" style="endArrow=classic;html=1;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="pause-check" target="pause-sleep">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Pause Loop Back -->
        <mxCell id="pause-loop" value="" style="endArrow=classic;html=1;strokeWidth=2;dashed=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="pause-sleep" target="start">
          <mxGeometry x="-60" y="20" relative="1" as="geometry">
            <mxPoint x="130" y="325" as="sourcePoint" />
            <mxPoint x="70" y="325" as="targetPoint" />
            <Array as="points">
              <mxPoint x="30" y="325" />
              <mxPoint x="30" y="155" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- dequeueFrame -->
        <mxCell id="dequeue" value="dequeueFrame()&#xa;1. AMediaCodec_dequeueOutputBuffer()&#xa;2. 获取帧元数据(PTS/宽高)&#xa;3. 保存 outputIndex&#xa;4. ❌ 不调用 releaseOutputBuffer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="250" y="195" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="pause-no" value="否" style="endArrow=classic;html=1;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="pause-check" target="dequeue">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Has Frame? -->
        <mxCell id="has-frame" value="取到帧?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="510" y="210" width="100" height="60" as="geometry" />
        </mxCell>
        <mxCell id="dequeue-to-check" value="" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="dequeue" target="has-frame">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Loop Back if no frame -->
        <mxCell id="no-frame-loop" value="" style="endArrow=classic;html=1;strokeWidth=2;dashed=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="has-frame" target="start">
          <mxGeometry x="100" y="-40" relative="1" as="geometry">
            <mxPoint x="560" y="210" as="sourcePoint" />
            <mxPoint x="660" y="170" as="targetPoint" />
            <Array as="points">
              <mxPoint x="660" y="240" />
              <mxPoint x="660" y="155" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="no-frame-label" value="否" style="endArrow=none;html=1;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="has-frame">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Calculate Sync -->
        <mxCell id="calc-sync" value="计算同步&#xa;diff = frame_pts - audio_clock&#xa;(视频 PTS - 音频主时钟)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="660" y="200" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="frame-yes" value="是" style="endArrow=classic;html=1;strokeWidth=2;fontColor=#82b366;fontSize=10;" edge="1" parent="1" source="has-frame" target="calc-sync">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Sync Decision -->
        <mxCell id="sync-decision" value="同步判断&#xa;diff 值范围?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="690" y="310" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="calc-to-decision" value="" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="calc-sync" target="sync-decision">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Branch 1: Too Early (Wait) -->
        <mxCell id="too-early" value="diff > 10ms&#xa;视频超前" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="300" y="320" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="decision-early" value="" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="sync-decision" target="too-early">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Wait Action -->
        <mxCell id="wait-action" value="av_usleep(diff * 1000)&#xa;等待音频追上" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="300" y="400" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="early-to-wait" value="" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="too-early" target="wait-action">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Branch 2: Normal (Render) -->
        <mxCell id="normal" value="-100ms ≤ diff ≤ 10ms&#xa;正常范围" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="690" y="420" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="decision-normal" value="" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="sync-decision" target="normal">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Branch 3: Too Late (Drop) -->
        <mxCell id="too-late" value="diff &lt; -100ms&#xa;视频落后" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="950" y="320" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="decision-late" value="" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="sync-decision" target="too-late">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Drop Action -->
        <mxCell id="drop-action" value="丢帧处理&#xa;不调用 renderOutputBuffer&#xa;pending buffer 在下次 dequeue 释放" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="950" y="400" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="late-to-drop" value="" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="too-late" target="drop-action">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- renderOutputBuffer -->
        <mxCell id="render" value="renderOutputBuffer()&#xa;AMediaCodec_releaseOutputBuffer(outputIndex, true)&#xa;渲染到 Surface" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="660" y="510" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="normal-to-render" value="" style="endArrow=classic;html=1;strokeWidth=2;fontColor=#82b366;" edge="1" parent="1" source="normal" target="render">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wait-to-render" value="" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="wait-action" target="render">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="370" y="450" as="sourcePoint" />
            <mxPoint x="660" y="540" as="targetPoint" />
            <Array as="points">
              <mxPoint x="370" y="540" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Loop Back to Start -->
        <mxCell id="loop-back" value="" style="endArrow=classic;html=1;strokeWidth=2;dashed=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="render" target="start">
          <mxGeometry x="-100" y="20" relative="1" as="geometry">
            <mxPoint x="760" y="510" as="sourcePoint" />
            <mxPoint x="860" y="155" as="targetPoint" />
            <Array as="points">
              <mxPoint x="860" y="540" />
              <mxPoint x="860" y="155" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Drop Loop Back -->
        <mxCell id="drop-loop" value="" style="endArrow=classic;html=1;strokeWidth=2;dashed=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="drop-action" target="start">
          <mxGeometry x="-120" y="10" relative="1" as="geometry">
            <mxPoint x="1040" y="400" as="sourcePoint" />
            <mxPoint x="1140" y="155" as="targetPoint" />
            <Array as="points">
              <mxPoint x="1140" y="430" />
              <mxPoint x="1140" y="155" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Legend Box -->
        <mxCell id="legend-title" value="配色说明" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1050" y="50" width="80" height="20" as="geometry" />
        </mxCell>
        <mxCell id="legend-blue" value="正常流程" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1050" y="75" width="100" height="25" as="geometry" />
        </mxCell>
        <mxCell id="legend-red" value="问题/关键" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1050" y="105" width="100" height="25" as="geometry" />
        </mxCell>
        <mxCell id="legend-green" value="成功/渲染" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1050" y="135" width="100" height="25" as="geometry" />
        </mxCell>
        <mxCell id="legend-yellow" value="判断节点" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1050" y="165" width="100" height="25" as="geometry" />
        </mxCell>
        <mxCell id="legend-purple" value="等待处理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1050" y="195" width="100" height="25" as="geometry" />
        </mxCell>

        <!-- Algorithm Summary -->
        <mxCell id="summary-box" value="核心算法：两步解耦&#xa;&#xa;Step 1: dequeueFrame() - 只取帧元数据，不渲染&#xa;Step 2: renderOutputBuffer() - 同步后渲染&#xa;&#xa;同步策略：&#xa;• 超前 >10ms: 等待音频追上&#xa;• 正常 [-100,10]ms: 立即渲染&#xa;• 落后 &lt;-100ms: 丢帧追赶" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="250" y="600" width="280" height="120" as="geometry" />
        </mxCell>

        <!-- Key Points -->
        <mxCell id="key-points" value="关键实现：&#xa;&#xa;1. 保存 outputIndex 用于后续渲染&#xa;2. 暂停状态检查避免无效 dequeue&#xa;3. pending buffer 在下次 dequeue 时自动释放&#xa;4. 音频主时钟 (audio_clock) 为基准" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="550" y="600" width="280" height="120" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
