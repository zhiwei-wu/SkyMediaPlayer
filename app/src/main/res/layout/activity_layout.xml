<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <imt.zw.skymediaplayer.widget.SkyVideoView
        android:id="@+id/sky_video_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 起播后顶部切换菜单：选择新视频/设置；起播前隐藏 -->
    <LinearLayout
        android:id="@+id/top_menu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="end"
        android:paddingTop="28dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <Button
            android:id="@+id/top_recent"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="最近"
            android:textSize="14sp"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/top_local"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="本地"
            android:textSize="14sp"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/top_online"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="在线"
            android:textSize="14sp"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/top_settings"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="⚙ 设置"
            android:textSize="14sp"
            android:textColor="#FFFFFF" />

    </LinearLayout>

    <!-- 空态选片菜单：首次进入居中显示，起播后隐藏 -->
    <LinearLayout
        android:id="@+id/empty_menu"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <Button
            android:id="@+id/btn_pick_local"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="播放本地文件"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btn_pick_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="播放在线视频"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/recent_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="最近播放"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:visibility="gone" />

        <!-- 最近播放的 3 项，运行时填充 -->
        <LinearLayout
            android:id="@+id/recent_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

</FrameLayout>